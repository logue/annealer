{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "annealer",
  "version": "0.1.0",
  "private": true,
  "description": "Reorders HTML/Vue attributes by semantic meaning using swappable YAML profiles.",
  "keywords": [
    "formatter"
  ],
  "homepage": "https://github.com/logue/annealer",
  "bugs": {
    "url": "https://github.com/logue/annealer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/annealer.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "import": "./dist/index.umd.js",
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm run build:wasm && rs dev",
    "dev:docs": "rs doc",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "analyze": "pnpm run build:wasm && RSDOCTOR=true rs lib",
    "test": "pnpm run build:wasm && rs test",
    "test:watch": "pnpm run build:wasm && rs test --watch",
    "clean": "rimraf demo dist docs src/wasm",
    "clean:hard": "rimraf demo dist docs src/wasm node_modules/.tmp node_modules/.cache",
    "build": "pnpm run build:wasm && rs lib",
    "build:demo": "pnpm run build:wasm && rs build",
    "build:docs": "rs doc build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "generate:tailwind": "node scripts/generate-tailwind-order.mjs",
    "preview": "rs preview",
    "preview:docs": "rs doc preview",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && (npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m')"
  },
  "devDependencies": {
    "@carbon/styles": "^1.118.0",
    "@carbon/web-components": "^2.66.0",
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsdoctor/cli": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspress/core": "^2.0.23",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-yml": "^3.9.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "react": "^19.3.1",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
